# ==============================================================================
# ANUBHAV Pilgrimage Mobility Platform — Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Credentials (CRITICAL: NEVER COMMIT SECRETS)
# ------------------------------------------------------------------------------
.env
*.env
*.env.local
*.env.*.local
backend/.env
!*.env.example
!.env.example

# ------------------------------------------------------------------------------
# 2. Python & Backend Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
/lib/
/lib64/
!flutter_app/lib/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
htmlcov/

# Type Checking & Linting
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.ruff_cache/

# ------------------------------------------------------------------------------
# 3. Flutter & Dart Build Artifacts
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/
.packages
.flutter-plugins
**/flutter_app/.dart_tool/
**/flutter_app/.flutter-plugins-dependencies
**/flutter_app/.pub-cache/
**/flutter_app/.pub/
**/flutter_app/build/
**/flutter_app/coverage/
**/flutter_app/.packages
**/flutter_app/.flutter-plugins

# Flutter symbolication and obfuscation
app.*.symbols
app.*.map.json

# Flutter Android artifacts
**/flutter_app/android/app/debug/
**/flutter_app/android/app/profile/
**/flutter_app/android/app/release/
**/flutter_app/android/.gradle/
**/flutter_app/android/captures/
**/flutter_app/android/local.properties
**/flutter_app/android/**/GeneratedPluginRegistrant.java

# Flutter iOS / macOS artifacts
**/flutter_app/ios/Flutter/.last_build_id
**/flutter_app/ios/Flutter/flutter_export_environment.sh
**/flutter_app/ios/Flutter/Generated.xcconfig
**/flutter_app/ios/Flutter/app.framework
**/flutter_app/ios/.symlinks/
**/flutter_app/ios/Pods/
**/flutter_app/macos/Flutter/ephemeral/
**/flutter_app/macos/Pods/

# Flutter Windows / Linux artifacts
**/flutter_app/windows/flutter/ephemeral/
**/flutter_app/linux/flutter/ephemeral/

# ------------------------------------------------------------------------------
# 4. Temporary Directories & Workspaces
# ------------------------------------------------------------------------------
.temp/
tmp/
temp/
scratch/

# ------------------------------------------------------------------------------
# 5. IDEs, Editors & Tooling
# ------------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~
*.bak

# ------------------------------------------------------------------------------
# 6. Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk
