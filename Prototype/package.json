{
  "name": "kumbh-saathi-monorepo",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite --host",
    "dev:multi": "concurrently -n \"API,PILGRIM,ADMIN,KIOSK\" -c \"blue,green,red,magenta\" \"npm run dev:api\" \"npm run dev:pilgrim\" \"npm run dev:admin\" \"npm run dev:kiosk\"",
    "dev:api": "npm --workspace=@kumbh-saathi/api run dev",
    "dev:pilgrim": "npm --workspace=@kumbh-saathi/pilgrim-app run dev",
    "dev:admin": "npm --workspace=@kumbh-saathi/admin run dev",
    "dev:kiosk": "npm --workspace=@kumbh-saathi/kiosk run dev",
    "build": "npm run build --workspaces",
    "start": "npm --workspace=@kumbh-saathi/api run start"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "maplibre-gl": "^6.7.0"
  }
}
