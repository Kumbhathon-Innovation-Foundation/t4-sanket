# Port for services/api
PORT=4000

# Supabase Postgres credentials (server-side only with service role key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT secret for admin token issuance
JWT_SECRET=kumbh-saathi-police-secret-key-2026

# Allowed frontend origins for strict CORS (comma-separated, NO wildcard in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://pilgrim.kumbhsaathi.in,https://admin.kumbhsaathi.in,https://kiosk.kumbhsaathi.in

# Optional LLM API Key (if calling hosted Anthropic/OpenAI/Gemini agent models)
LLM_API_KEY=your-llm-api-key-if-applicable
